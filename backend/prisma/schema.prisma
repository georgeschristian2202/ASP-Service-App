generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum RoleUtilisateur {
  SUPERADMINISTRATEUR @map("SUPERADMIN")
  ADMINISTRATEUR @map("ADMIN")
  EDITEUR        @map("EDITOR")

  @@map("UserRole")
}

model Utilisateur {
  identifiant       String          @id @default(uuid()) @map("id")
  nomUtilisateur    String          @unique @map("username")
  courriel          String          @unique @map("email")
  motDePasseHache   String          @map("passwordHash")
  role              RoleUtilisateur @default(ADMINISTRATEUR)
  creeLe            DateTime        @default(now()) @map("createdAt")
  modifieLe         DateTime        @updatedAt @map("updatedAt")
  sessions          SessionAuthentification[]

  @@map("users")
}

model SessionAuthentification {
  identifiant            String      @id @default(uuid()) @map("id")
  identifiantUtilisateur String      @map("userId")
  expireLe               DateTime    @map("expiresAt")
  revoqueLe              DateTime?   @map("revokedAt")
  creeLe                 DateTime    @default(now()) @map("createdAt")
  utilisateur            Utilisateur @relation(fields: [identifiantUtilisateur], references: [identifiant], onDelete: Cascade)

  @@index([identifiantUtilisateur])
  @@index([expireLe])
  @@map("auth_sessions")
}

model Realisation {
  identifiant       String   @id @default(uuid()) @map("id")
  titre             String   @map("title")
  categorie         String   @map("category")
  description       String   @default("")
  urlImage          String   @default("") @map("imageUrl")
  cheminImage       String   @default("") @map("imagePath")
  etiquettes        String[] @default([]) @map("tags")
  aLaUne            Boolean  @default(false) @map("featured")
  ordreAffichage    Int      @default(999) @map("orderIndex")
  creeLe            DateTime @default(now()) @map("createdAt")
  modifieLe         DateTime @updatedAt @map("updatedAt")

  @@index([categorie])
  @@index([aLaUne])
  @@index([ordreAffichage])
  @@map("portfolio_items")
}

model ConfigurationSite {
  identifiant String   @id @default("default") @map("id")
  donnees     Json     @map("data")
  creeLe      DateTime @default(now()) @map("createdAt")
  modifieLe   DateTime @updatedAt @map("updatedAt")

  @@map("site_configurations")
}

model ContenuPage {
  identifiant String   @id @default(uuid()) @map("id")
  cle         String   @unique @map("key")
  donnees     Json     @map("data")
  creeLe      DateTime @default(now()) @map("createdAt")
  modifieLe   DateTime @updatedAt @map("updatedAt")

  @@map("page_contents")
}

model MessageContact {
  identifiant String   @id @default(uuid()) @map("id")
  nom         String   @map("name")
  courriel    String   @map("email")
  telephone   String?  @map("phone")
  objet       String?  @map("subject")
  message     String
  estLu       Boolean  @default(false) @map("isRead")
  creeLe      DateTime @default(now()) @map("createdAt")
  modifieLe  DateTime @updatedAt @map("updatedAt")

  @@index([estLu])
  @@index([creeLe])
  @@map("contact_messages")
}
