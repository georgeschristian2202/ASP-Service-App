# Server Configuration
NODE_ENV=development
PORT=5001
HOST=localhost

# Database Configuration
DATABASE_URL=postgresql://postgres:change-this-password@localhost:5432/Asp-Service?schema=public

# JWT Configuration
JWT_SECRET=change-this-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRE=30d
JWT_ACCESS_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=30d

# CORS Configuration
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# SMTP (utiliser un mot de passe local, jamais commité dans Git)
SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@example.com
SMTP_PASSWORD=change-this-smtp-password
SMTP_FROM=contact@example.com
SMTP_FROM_NAME=CONTACT ASPSERVICES
SMTP_TO=contact@example.com

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

# Security
BCRYPT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# API Keys (if needed)
STRIPE_SECRET_KEY=
GOOGLE_MAPS_API_KEY=

# Admin Configuration
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-secure-password
